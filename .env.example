# Privacy policy: "standard" permits configured providers/integrations;
# "local_only" forces a loopback Ollama model, blocks cloud LLM/fallback,
# online TTS, network tools, and autonomous agent mode. See docs/PRIVACY.md.
JARVIS_PRIVACY_MODE=standard

# JARVIS MARK 7 does not require any cloud API key in .env.local.
#
# JARVIS does not show an API popup at startup. Say "change my API key" or
# "change AI" to open the provider panel. Ollama requires no API key and can
# run fully offline on the same computer. Cloud keys are validated and held
# only in server memory; they are never written to this file.
#
# The optional settings below just let you override the default model per
# provider, or point at a local model server instead of any cloud provider.
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
GEMINI_MODEL=gemini-flash-latest
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-sonnet-5

# Fallback / local-model settings (optional, unrelated to the popup above).
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2

# ——— Voice: online TTS (AI-response voice, optional) ———
# JARVIS speaks with the browser's built-in "speechSynthesis" voice by
# default — no setup needed, and it's always the fallback if anything below
# is missing or unreachable. Configuring one of these providers here just
# upgrades the *spoken AI reply* to a higher-quality online voice; local
# commands always use the browser's default voice regardless of this
# setting. Like the chat providers, this key is read server-side only
# (app/api/tts/route.ts) and is never sent to the browser.
#
# TTS_PROVIDER selects which one is used: "elevenlabs" (default) or "openai".
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
OPENAI_API_KEY=
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_MODEL=gpt-4o-mini-tts


# --- JARVIS Remote Command Gateway (disabled by default) ---
# Set true only after configuring at least one provider webhook and the
# sender allowlist below. Both Telegram and Discord can be configured at
# once - just leave a provider's variables blank to skip it.
JARVIS_REMOTE_ENABLED=false
# Sender IDs are namespaced per provider so they can never collide:
#   telegram:<numeric user id>   e.g. telegram:123456789
#   discord:<numeric user id>    e.g. discord:987654321098765432
REMOTE_ALLOWED_SENDERS=telegram:123456789,discord:987654321098765432
REMOTE_RATE_LIMIT_MS=2500
REMOTE_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# ——— Telegram bot ———
# Create a bot with @BotFather to get the token, then register the webhook
# once with (replace the placeholders):
#   https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook?url=https://your-public-https-domain.example/api/remote/telegram&secret_token=<TELEGRAM_WEBHOOK_SECRET>
# TELEGRAM_WEBHOOK_SECRET can be any long random string you choose - Telegram
# echoes it back on every request so the webhook route can verify the sender.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret

# ——— Discord bot ———
# From the Discord Developer Portal, on your application's General
# Information page: DISCORD_APPLICATION_ID is the Application ID and
# DISCORD_PUBLIC_KEY is the Public Key. Set the "Interactions Endpoint URL"
# to https://your-public-https-domain.example/api/remote/discord, and
# register a slash command (e.g. `/jarvis command:<text>`) with a required
# string option named "command" using DISCORD_BOT_TOKEN against the Discord
# API. DISCORD_BOT_TOKEN is only needed once, to register that command -
# replies are delivered via the interaction's own webhook token, so no bot
# token is read at runtime.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Browser/API access is authenticated with JARVIS_ACCESS_TOKEN and an HttpOnly session cookie.

# ——— Tools & memory (no setup required) ———
# The AI can now call tools mid-conversation: remember_fact/recall_fact/
# forget_fact (persisted to ./data/memory.json, gitignored), get_current_time,
# and web_search (DuckDuckGo's free Instant Answer API — no key needed).
# Only used automatically when the active provider's model supports OpenAI-
# style function calling; if a model rejects the "tools" field, the chat
# route detects that and transparently retries without it. Nothing to
# configure here — this section exists just so it's documented somewhere.

# Smart-home controls are out of scope for the current MARK 7 release.

# ——— Calendar & email (Google) ———
# Optional. One Google Cloud project covers both:
#   1. console.cloud.google.com → new project → enable the "Google Calendar
#      API" and "Gmail API".
#   2. OAuth consent screen → add yourself as a test user.
#   3. Credentials → Create Credentials → OAuth client ID → Desktop app.
#      Note the client ID and secret.
#   4. Run Google's OAuth 2.0 Playground (developers.google.com/oauthplayground),
#      gear icon → "Use your own OAuth credentials" → paste client
#      id/secret → select scopes:
#        https://www.googleapis.com/auth/calendar
#        https://www.googleapis.com/auth/gmail.readonly
#      → Authorize → Exchange authorization code for tokens → copy the
#      Refresh token shown there into GOOGLE_REFRESH_TOKEN below.
# This is a one-time setup step; the refresh token doesn't expire under
# normal use. Calendar (read + create events) and Gmail (read-only, no
# sending) both come online once these three are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Host application, volume, media, and browser control are out of scope for
# the current MARK 7 release. SYSTEM_APP_ALLOWLIST is intentionally unused.
SYSTEM_APP_ALLOWLIST=

# ——— Proactive briefing ———
# Optional. POST /api/briefing (with header x-jarvis-admin-token:
# <REMOTE_ADMIN_TOKEN>, set above under the Remote Command Gateway section)
# on whatever schedule you want (cron, Task Scheduler, a free external cron
# service) to get an unprompted summary of upcoming calendar events and
# unread email. Add ?delivery=telegram to push it to Telegram instead of
# just returning it as JSON — requires the Telegram bot already configured
# above, plus your own chat id here (message your bot once, then check
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id).
TELEGRAM_BRIEFING_CHAT_ID=

# Optional default city for the weather line in /api/briefing, used when the
# request doesn't pass ?place=. Weather itself needs no key (Open-Meteo).
BRIEFING_DEFAULT_PLACE=

# Required for browser/API authentication. Generate with: openssl rand -hex 32
JARVIS_ACCESS_TOKEN=

# Local long-term memory consolidation (true by default)
JARVIS_MEMORY_CONSOLIDATION=true

# Advanced JARVIS MARK 7 agent architecture
# auto = planner/executor/QA only for complex multi-step requests; always/off also supported.
JARVIS_AGENT_MODE=auto
JARVIS_AGENT_TIMEOUT_MS=25000
# Enable only if you add trusted server-side tools through registerTool().
JARVIS_DYNAMIC_TOOLS=false

# Optional per-provider pricing used by the local usage tracker.
# Values are USD per 1 million input/output tokens.
# Example:
# JARVIS_GROQ_INPUT_USD_PER_1M=0
# JARVIS_GROQ_OUTPUT_USD_PER_1M=0

# ——— Autocoder (self-editing code agent) ———
# Off by default. When on, an AUTOCODER button appears in the UI and the agent gets an `autocode` tool.
AUTOCODER_ENABLED=false
# propose = every change waits for your approval in the panel (recommended)
# auto    = changes apply by themselves, but ONLY while you have armed auto mode in the UI (time-limited)
AUTOCODER_MODE=propose
# How many times it may try to fix its own type errors before rolling back (0-4)
AUTOCODER_REPAIR_ROUNDS=2
# Extra protected path prefixes, comma separated (* wildcard ok), e.g. lib/memory/*,app/api/chat/*
AUTOCODER_PROTECTED=

# ——— Approvals inbox ———
# Tool calls listed here are NOT run when the AI (or a Telegram/Discord command) asks for them. They wait in the
# Command Center → Approvals tab until you approve. Empty = nothing is held (previous behaviour).
# Example: JARVIS_APPROVAL_TOOLS=create_calendar_event
JARVIS_APPROVAL_TOOLS=
# Minutes before an unapproved request expires (minimum 1)
JARVIS_APPROVAL_TTL_MIN=30
# Shows live weather + location in the Command Center (and the briefing)
# BRIEFING_DEFAULT_PLACE=Berlin

# ——— Plugins ———
# Tools from plugins/*/index.ts load automatically (see plugins/README.md). Set to off to load none.
# JARVIS_PLUGINS=off

# ——— Docker only ———
# Where the container finds Ollama. Default is the bundled service (docker compose --profile ollama up).
# For Ollama running on your host instead: DOCKER_LLM_BASE_URL=http://host.docker.internal:11434/v1
# DOCKER_LLM_BASE_URL=
# JARVIS_BIND=127.0.0.1
# JARVIS_PORT=3000

# Legacy Android Hands is excluded from the current MARK 7 release. Keep both
# flags unset/false. Only enable for isolated experiments after a separate
# device-controller security review.
JARVIS_EXPERIMENTAL_DEVICE_CONTROL=false
ANDROID_HANDS_ENABLED=false

# --- Outbound fetch guard (browser_fetch) -----------------------------------------------------
# The model-driven URL fetcher only reaches the public internet. Loopback, private LAN, link-local
# and cloud-metadata addresses are blocked, on every redirect hop. Opt in only if you need LAN access:
#   JARVIS_FETCH_ALLOW_HOSTS=nas.local,192.168.1.20   (specific hosts only; preferred)
#   JARVIS_FETCH_ALLOW_PRIVATE=true                   (all private ranges; avoid)
JARVIS_FETCH_ALLOW_HOSTS=
JARVIS_FETCH_ALLOW_PRIVATE=false
